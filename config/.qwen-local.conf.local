# Local machine overrides for ai-local-dev
# This file is sourced after config/.qwen-local.conf.
QWEN_SESSION_TOKEN_LIMIT=64000
LLAMA_CTX_SIZE=65536
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_PROXY_FORCE_THINK=1
AI_LOCAL_THINK_TEMP=0.2
AI_LOCAL_THINK_TOP_P=0.85
AI_LOCAL_SINGLE_MODEL_MODE=1
