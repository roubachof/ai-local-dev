#!/usr/bin/env bash
# ============================================================================
# ai-local — Unified Local AI Orchestrator
# ============================================================================
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]:-$0}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
AI_LOCAL_DEV_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ ! -f "$AI_LOCAL_DEV_DIR/config/.qwen-local.conf" ]] && \
   [[ -f "$HOME/.local/share/ai-local-dev/config/.qwen-local.conf" ]]; then
    AI_LOCAL_DEV_DIR="$HOME/.local/share/ai-local-dev"
fi

# shellcheck disable=SC1091
source "$AI_LOCAL_DEV_DIR/lib/qwen-config.sh"
load_qwen_config
ensure_state_dirs

log_info()    { echo "📌 $*"; }
log_warn()    { echo "⚠️  $*"; }
log_success() { echo "✅ $*"; }
log_error()   { echo "❌ $*" >&2; exit 1; }

find_python() {
    if [[ -f "$AI_LOCAL_DEV_DIR/.venv/bin/python" ]]; then
        echo "$AI_LOCAL_DEV_DIR/.venv/bin/python"
    elif [[ -f "$(pwd)/.venv/bin/python" ]]; then
        echo "$(pwd)/.venv/bin/python"
    else
        echo "python3"
    fi
}

pid_file() {
    local service=$1
    echo "$AI_LOCAL_RUN_DIR/${service}.pid"
}

save_pid() {
    local service=$1
    local pid=$2
    echo "$pid" > "$(pid_file "$service")"
}

load_pid() {
    local service=$1
    local file
    file="$(pid_file "$service")"
    if [[ -f "$file" ]]; then
        cat "$file"
    fi
}

clear_pid() {
    local service=$1
    rm -f "$(pid_file "$service")"
}

is_pid_alive() {
    local pid=$1
    kill -0 "$pid" >/dev/null 2>&1
}

kill_pid_gracefully() {
    local pid=$1
    kill "$pid" >/dev/null 2>&1 || true
    for _ in {1..10}; do
        if ! is_pid_alive "$pid"; then
            return 0
        fi
        sleep 0.2
    done
    kill -9 "$pid" >/dev/null 2>&1 || true
}

stop_service() {
    local service=$1
    local display_name=$2
    local fallback_pattern="${3:-}"
    local allow_fallback="${4:-1}"

    local pid
    pid="$(load_pid "$service" || true)"
    if [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]]; then
        if is_pid_alive "$pid"; then
            kill_pid_gracefully "$pid"
            clear_pid "$service"
            log_success "Stopped ${display_name} (PID $pid)"
            return 0
        fi
        clear_pid "$service"
    fi

    if [[ "$allow_fallback" == "1" && -n "$fallback_pattern" ]]; then
        pkill -f "$fallback_pattern" >/dev/null 2>&1 || true
    fi
}

start_llama_server() {
    ensure_state_dirs
    if is_service_running "$LLAMA_PORT" "/health"; then
        log_success "llama-server already running on port $LLAMA_PORT"
        return 0
    fi
    if [[ ! -f "$QWEN_27B_MODEL" ]]; then
        log_error "Model not found: $QWEN_27B_MODEL"
    fi
    log_info "Starting llama-server on port $LLAMA_PORT"
    nohup llama-server \
        --model "$QWEN_27B_MODEL" \
        --port "$LLAMA_PORT" \
        --ctx-size "$LLAMA_CTX_SIZE" \
        --temp "$LLAMA_TEMP" \
        --top-p "$LLAMA_TOP_P" \
        --top-k "$LLAMA_TOP_K" \
        --n-gpu-layers "$LLAMA_GPU_LAYERS" \
        --reasoning-format "$LLAMA_REASONING_FORMAT" \
        > "$AI_LOCAL_LOG_DIR/llama-server.log" 2>&1 &
    save_pid "llama" "$!"
    wait_for_service "$LLAMA_PORT" "/health" "$SERVICE_STARTUP_WAIT" \
        || log_error "llama-server failed to become healthy"
}

start_mlx_server() {
    ensure_state_dirs
    if is_service_running "$MLX_PORT" "/v1/models"; then
        log_success "mlx_lm.server already running on port $MLX_PORT"
        return 0
    fi
    local py
    py="$(find_python)"
    "$py" -c "import mlx_lm" >/dev/null 2>&1 \
        || log_error "mlx_lm not available. Install dependencies: $py -m pip install -r requirements.txt"
    log_info "Starting mlx_lm.server on port $MLX_PORT"
    nohup "$py" -m mlx_lm.server \
        --model "$QWEN_27B_MLX_MODEL" \
        --host 127.0.0.1 \
        --port "$MLX_PORT" \
        --temp "$MLX_TEMP" \
        --top-p "$MLX_TOP_P" \
        > "$AI_LOCAL_LOG_DIR/mlx-server.log" 2>&1 &
    save_pid "mlx" "$!"
    wait_for_service "$MLX_PORT" "/v1/models" "$SERVICE_STARTUP_WAIT" \
        || log_error "mlx_lm.server failed to become healthy"
}

start_ollama() {
    ensure_state_dirs
    if is_service_running "$OLLAMA_PORT" "/api/tags"; then
        log_success "Ollama already running on port $OLLAMA_PORT"
        return 0
    fi
    command -v ollama >/dev/null 2>&1 || log_error "Ollama not installed: https://ollama.com"
    log_info "Starting Ollama on port $OLLAMA_PORT"
    nohup ollama serve > "$AI_LOCAL_LOG_DIR/ollama.log" 2>&1 &
    save_pid "ollama" "$!"
    wait_for_service "$OLLAMA_PORT" "/api/tags" "$SERVICE_STARTUP_WAIT" \
        || log_error "Ollama failed to become healthy"
}

start_proxy() {
    local service=$1
    local mode=$2
    local listen_port=$3
    local upstream_url=$4
    local log_file=$5

    ensure_state_dirs
    if is_service_running "$listen_port" "/health"; then
        log_success "${service} already running on port $listen_port"
        return 0
    fi

    local py
    py="$(find_python)"
    log_info "Starting ${service} on port $listen_port -> $upstream_url"
    nohup env \
        PROXY_TIMEOUT="$PROXY_TIMEOUT" \
        AI_LOCAL_FORCE_THINK="$AI_LOCAL_FORCE_THINK" \
        LLAMA_PROXY_FORCE_THINK="$LLAMA_PROXY_FORCE_THINK" \
        OLLAMA_PROXY_FORCE_THINK="$OLLAMA_PROXY_FORCE_THINK" \
        OLLAMA_PROXY_THINK="$OLLAMA_PROXY_THINK" \
        AI_LOCAL_NOTHINK_TEMP="$AI_LOCAL_NOTHINK_TEMP" \
        AI_LOCAL_NOTHINK_TOP_P="$AI_LOCAL_NOTHINK_TOP_P" \
        AI_LOCAL_THINK_TEMP="$AI_LOCAL_THINK_TEMP" \
        AI_LOCAL_THINK_TOP_P="$AI_LOCAL_THINK_TOP_P" \
        "$py" "$AI_LOCAL_DEV_DIR/bin/nothink_proxy.py" \
        --mode "$mode" \
        --port "$listen_port" \
        --upstream-url "$upstream_url" \
        > "$AI_LOCAL_LOG_DIR/$log_file" 2>&1 &
    save_pid "$service" "$!"
    wait_for_service "$listen_port" "/health" "$SERVICE_STARTUP_WAIT" \
        || log_error "${service} failed to become healthy"
}

start_proxy_27b() {
    local backend=$1
    local upstream
    case "$backend" in
        mlx)   upstream="http://127.0.0.1:${MLX_PORT}" ;;
        llama) upstream="http://127.0.0.1:${LLAMA_PORT}" ;;
        *)     log_error "Unsupported 27B backend: $backend" ;;
    esac
    start_proxy "proxy-27b" "llama" "$LLAMA_PROXY_PORT" "$upstream" "proxy-27b.log"
}

start_proxy_35b() {
    start_proxy "proxy-35b" "ollama" "$OLLAMA_PROXY_PORT" "http://127.0.0.1:${OLLAMA_PORT}" "proxy-35b.log"
}

start_router() {
    ensure_state_dirs
    if is_service_running "$ROUTER_PORT" "/health"; then
        log_success "model-router already running on port $ROUTER_PORT"
        return 0
    fi
    local py
    py="$(find_python)"
    log_info "Starting model-router on port $ROUTER_PORT"
    nohup "$py" "$AI_LOCAL_DEV_DIR/bin/model_router.py" \
        --port "$ROUTER_PORT" \
        --planner-url "http://127.0.0.1:${LLAMA_PROXY_PORT}" \
        --coder-url "http://127.0.0.1:${OLLAMA_PROXY_PORT}" \
        > "$AI_LOCAL_LOG_DIR/router.log" 2>&1 &
    save_pid "router" "$!"
    wait_for_service "$ROUTER_PORT" "/health" "$SERVICE_STARTUP_WAIT" \
        || log_error "model-router failed to become healthy"
}

stop_27b() {
    stop_service "proxy-27b" "27B proxy" "nothink_proxy.py.*--port[ =]${LLAMA_PROXY_PORT}" 1
    stop_service "llama" "llama-server" "llama-server.*--port[ =]${LLAMA_PORT}" 1
    stop_service "mlx" "mlx_lm.server" "mlx_lm.server.*--port[ =]${MLX_PORT}" 1
}

stop_35b() {
    stop_service "proxy-35b" "Ollama proxy (35B / optional 8B no-think)" "nothink_proxy.py.*--port[ =]${OLLAMA_PROXY_PORT}" 1
    # Only stop ollama if ai-local started it (PID file exists).
    stop_service "ollama" "Ollama" "" 0
}

stop_all() {
    log_info "Stopping all ai-local managed services"
    stop_27b
    stop_35b
    stop_service "router" "model-router" "model_router.py.*--port[ =]${ROUTER_PORT}" 1
    log_success "Stop completed."
}

get_memory_mb() {
    local pid=$1
    if [[ -z "$pid" ]] || ! is_pid_alive "$pid"; then
        return
    fi
    local rss_kb
    rss_kb="$(ps -p "$pid" -o rss= 2>/dev/null | tr -d ' ')"
    if [[ -n "$rss_kb" ]]; then
        awk "BEGIN { print int($rss_kb/1024) }"
    fi
}

status_line() {
    local label=$1
    local port=$2
    local path=$3
    local pid_service=$4
    local fallback_pattern=$5

    if is_service_running "$port" "$path"; then
        log_success "$label → port $port"
        return 0
    fi

    local pid
    pid="$(load_pid "$pid_service" || true)"
    if [[ -z "$pid" ]]; then
        pid="$(pgrep -f "$fallback_pattern" | head -1 || true)"
    fi
    if [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]]; then
        if is_pid_alive "$pid"; then
            local mem
            mem="$(get_memory_mb "$pid")"
            if [[ -n "$mem" ]]; then
                log_warn "$label → port $port (process alive: PID $pid, ${mem}MB RAM)"
            else
                log_warn "$label → port $port (process alive: PID $pid)"
            fi
        else
            log_warn "$label → port $port (stopped)"
        fi
    else
        log_warn "$label → port $port (stopped)"
    fi
}

show_status() {
    echo "=== ai-local Status ==="
    echo ""
    echo "27B backend selected: ${BACKEND_27B}"
    status_line "llama-server (27B fallback)" "$LLAMA_PORT" "/health" "llama" "llama-server.*--port[ =]${LLAMA_PORT}"
    status_line "mlx_lm.server (27B primary)" "$MLX_PORT" "/v1/models" "mlx" "mlx_lm.server.*--port[ =]${MLX_PORT}"
    status_line "27B proxy" "$LLAMA_PROXY_PORT" "/health" "proxy-27b" "nothink_proxy.py.*--port[ =]${LLAMA_PROXY_PORT}"
    status_line "Ollama (8B/35B)" "$OLLAMA_PORT" "/api/tags" "ollama" "ollama serve"
    status_line "Ollama proxy (35B / optional 8B no-think)" "$OLLAMA_PROXY_PORT" "/health" "proxy-35b" "nothink_proxy.py.*--port[ =]${OLLAMA_PROXY_PORT}"
    status_line "model-router" "$ROUTER_PORT" "/health" "router" "model_router.py.*--port[ =]${ROUTER_PORT}"
    echo ""
    echo "Logs: $AI_LOCAL_LOG_DIR"
    echo "Run files: $AI_LOCAL_RUN_DIR"
}

update_goose_settings() {
    local provider=$1
    local model=$2
    local host=$3
    local openai_base_url=$4
    local goose_config="$AI_LOCAL_DEV_DIR/config/goose/config.yaml"
    [[ -f "$goose_config" ]] || log_error "Goose config template not found: $goose_config"
    sed -i '' \
        -e "s|^OLLAMA_HOST:.*|OLLAMA_HOST: $host|" \
        -e "s|^GOOSE_PROVIDER:.*|GOOSE_PROVIDER: $provider|" \
        -e "s|^GOOSE_MODEL:.*|GOOSE_MODEL: $model|" \
        -e "s|^OPENAI_API_BASE:.*|OPENAI_API_BASE: $openai_base_url|" \
        "$goose_config"
}

start_27b_with_backend() {
    local backend=$1
    local qwen_model_id=""
    case "$backend" in
        llama)
            start_llama_server
            qwen_model_id="$(basename "$QWEN_27B_MODEL")"
            ;;
        mlx)
            start_mlx_server
            qwen_model_id="$QWEN_27B_MLX_MODEL"
            ;;
        *)     log_error "Invalid backend '$backend' (expected mlx or llama)" ;;
    esac
    start_proxy_27b "$backend"
    update_qwen_settings "http://127.0.0.1:${LLAMA_PROXY_PORT}/v1" "$qwen_model_id"
    update_goose_settings "openai" "local-27b" "http://localhost:${LLAMA_PROXY_PORT}" "http://localhost:${LLAMA_PROXY_PORT}/v1"
    log_success "Qwen3.6-27B (${backend}) ready on http://127.0.0.1:${LLAMA_PROXY_PORT}/v1"
}

start_35b_stack() {
    start_ollama
    start_proxy_35b
    update_qwen_settings "http://127.0.0.1:${OLLAMA_PROXY_PORT}/v1" "$QWEN_35B_OLLAMA_MODEL"
    update_goose_settings "ollama" "$QWEN_35B_OLLAMA_MODEL" "http://localhost:${OLLAMA_PROXY_PORT}" "http://localhost:${OLLAMA_PROXY_PORT}/v1"
    log_success "Qwen3.6-35B-A3B ready on http://127.0.0.1:${OLLAMA_PROXY_PORT}/v1"
}
start_8b_stack() {
    start_ollama
    update_qwen_settings "http://127.0.0.1:${OLLAMA_PORT}/v1" "$QWEN_8B_OLLAMA_MODEL"
    update_goose_settings "ollama" "$QWEN_8B_OLLAMA_MODEL" "http://localhost:${OLLAMA_PORT}" "http://localhost:${OLLAMA_PORT}/v1"
    log_success "Qwen3-8B ready on http://127.0.0.1:${OLLAMA_PORT}/v1 (thinking enabled by default)"
}

check_goose() {
    command -v goose >/dev/null 2>&1 || log_error "Goose not installed: brew install block-goose-cli"
}

launch_goose() {
    check_goose
    local settings_file="$HOME/.qwen/settings.json"
    [[ -f "$settings_file" ]] || log_error "No model configured. Run 'ai-local 27b', 'ai-local 8b', or 'ai-local 35b' first."
    local model
    model="$(python3 -c "import json;print(json.load(open('$settings_file'))['model']['name'])" 2>/dev/null || true)"
    if [[ "$model" == *"35b"* ]]; then
        start_ollama
        start_proxy_35b
        log_info "Launching Goose via Ollama proxy (no-think)"
        OLLAMA_HOST="http://localhost:${OLLAMA_PROXY_PORT}" goose session
        return 0
    fi
    if [[ "$model" == *"8b"* ]]; then
        start_ollama
        log_info "Launching Goose via direct Ollama (8B think by default)"
        OLLAMA_HOST="http://localhost:${OLLAMA_PORT}" goose session
        return 0
    fi

    start_proxy_27b "$BACKEND_27B"
    log_info "Launching Goose via 27B proxy (${BACKEND_27B})"
    OLLAMA_HOST="http://localhost:${LLAMA_PROXY_PORT}" goose session
}

launch_goose_think() {
    check_goose
    start_ollama
    log_info "Launching Goose with thinking ON (direct to Ollama ${OLLAMA_PORT})"
    OLLAMA_HOST="http://localhost:${OLLAMA_PORT}" goose session
}

launch_qwen() {
    local settings_file="$HOME/.qwen/settings.json"
    [[ -f "$settings_file" ]] || log_error "qwen-code not configured. Run 'ai-local 27b', 'ai-local 8b', or 'ai-local 35b' first."
    exec qwen "$@"
}

launch_qwen_think() {
    start_ollama
    update_qwen_settings "http://127.0.0.1:${OLLAMA_PORT}/v1" "$QWEN_35B_OLLAMA_MODEL"
    log_info "Launching qwen-code in thinking mode (direct Ollama)"
    exec qwen "$@"
}

show_logs() {
    local service=$1
    local file=""
    case "$service" in
        27b|27b-proxy|proxy-27b) file="$AI_LOCAL_LOG_DIR/proxy-27b.log" ;;
        llama|27b-llama) file="$AI_LOCAL_LOG_DIR/llama-server.log" ;;
        mlx|27b-mlx) file="$AI_LOCAL_LOG_DIR/mlx-server.log" ;;
        8b) file="$AI_LOCAL_LOG_DIR/ollama.log" ;;
        8b-proxy) file="$AI_LOCAL_LOG_DIR/proxy-35b.log" ;;
        35b|35b-proxy|proxy-35b) file="$AI_LOCAL_LOG_DIR/proxy-35b.log" ;;
        ollama) file="$AI_LOCAL_LOG_DIR/ollama.log" ;;
        router) file="$AI_LOCAL_LOG_DIR/router.log" ;;
        *) log_error "Unknown logs target: $service" ;;
    esac
    [[ -f "$file" ]] || log_error "Log file not found: $file"
    tail -n 200 -f "$file"
}

download_model() {
    local target=$1
    case "$target" in
        27b)
            if [[ "$BACKEND_27B" == "mlx" ]]; then
                download_model "27b-mlx"
            else
                download_model "27b-llama"
            fi
            ;;
        27b-llama)
            command -v huggingface-cli >/dev/null 2>&1 || log_error "huggingface-cli is required for 27b-llama download"
            mkdir -p "$(dirname "$QWEN_27B_MODEL")"
            huggingface-cli download unsloth/Qwen3.6-27B-GGUF \
                Qwen3.6-27B-UD-Q4_K_XL.gguf \
                --local-dir "$(dirname "$QWEN_27B_MODEL")"
            ;;
        27b-mlx)
            command -v huggingface-cli >/dev/null 2>&1 || log_error "huggingface-cli is required for MLX model pre-download"
            huggingface-cli download "$QWEN_27B_MLX_MODEL"
            ;;
        35b)
            command -v ollama >/dev/null 2>&1 || log_error "Ollama not installed"
            ollama pull "$QWEN_35B_OLLAMA_MODEL"
            ;;
        8b)
            command -v ollama >/dev/null 2>&1 || log_error "Ollama not installed"
            ollama pull "$QWEN_8B_OLLAMA_MODEL"
            ;;
        *)
            log_error "Unknown download target: $target (expected 27b, 27b-llama, 27b-mlx, 8b, 35b)"
            ;;
    esac
}

doctor() {
    local failed=0
    local required_cmds=("python3" "curl" "node")
    local optional_cmds=("ollama" "llama-server" "huggingface-cli")

    echo "=== ai-local doctor ==="
    for cmd in "${required_cmds[@]}"; do
        if command -v "$cmd" >/dev/null 2>&1; then
            log_success "Found command: $cmd"
        else
            log_warn "Missing command: $cmd"
            failed=1
        fi
    done

    for cmd in "${optional_cmds[@]}"; do
        if command -v "$cmd" >/dev/null 2>&1; then
            log_success "Optional command available: $cmd"
        else
            log_warn "Optional command missing: $cmd"
        fi
    done

    local py
    py="$(find_python)"
    if "$py" -c "import fastapi, httpx, uvicorn" >/dev/null 2>&1; then
        log_success "Python proxy dependencies import correctly"
    else
        log_warn "Python proxy dependencies missing in $py env"
        failed=1
    fi

    if "$py" -c "import mlx_lm" >/dev/null 2>&1; then
        log_success "mlx_lm import OK"
    else
        log_warn "mlx_lm import failed (required for BACKEND_27B=mlx)"
    fi

    if [[ "$BACKEND_27B" == "llama" && ! -f "$QWEN_27B_MODEL" ]]; then
        log_warn "27B GGUF missing: $QWEN_27B_MODEL"
        failed=1
    fi

    if is_service_running "$LLAMA_PROXY_PORT" "/health"; then
        log_success "27B proxy health check OK"
    else
        log_warn "27B proxy is not healthy on port $LLAMA_PROXY_PORT"
    fi
    if is_service_running "$OLLAMA_PROXY_PORT" "/health"; then
        log_success "Ollama proxy health check OK"
    else
        log_warn "Ollama proxy is not healthy on port $OLLAMA_PROXY_PORT"
    fi

    if [[ "$failed" -eq 0 ]]; then
        log_success "Doctor checks passed"
    else
        log_warn "Doctor found required issues"
        return 1
    fi
}

restart_stack() {
    local target=$1
    case "$target" in
        27b)
            stop_27b
            start_27b_with_backend "$BACKEND_27B"
            ;;
        35b)
            stop_35b
            start_35b_stack
            ;;
        8b)
            stop_35b
            start_8b_stack
            ;;
        *)
            log_error "Usage: ai-local restart [27b|8b|35b]"
            ;;
    esac
}

usage() {
    cat << EOF
ai-local — Unified Local AI Orchestrator

Usage:
  ai-local goose [think]         Launch Goose (default via active model endpoint)
  ai-local qwen [think]          Launch qwen-code (or thinking direct mode)
  ai-local 27b                   Start 27B stack using BACKEND_27B
  ai-local 27b-mlx               Start 27B stack with MLX backend
  ai-local 27b-llama             Start 27B stack with llama.cpp backend
  ai-local 8b                    Start 8B stack (direct Ollama, think by default)
  ai-local 35b                   Start 35B stack (Ollama + proxy)
  ai-local restart [27b|8b|35b]  Restart selected stack
  ai-local stop [27b|8b|35b|all] Stop selected stack (or all by default)
  ai-local status                Show service status
  ai-local logs <service>        Tail logs (27b, llama, mlx, 8b, 35b, ollama, router)
  ai-local download <target>     Download model (27b, 27b-llama, 27b-mlx, 8b, 35b)
  ai-local doctor                Run diagnostics
  ai-local config                Show resolved configuration
  ai-local proxy {start|stop|status}
  ai-local router {start|stop|status}

Notes:
  - Logs are stored in: $AI_LOCAL_LOG_DIR
  - Runtime PID files are stored in: $AI_LOCAL_RUN_DIR
  - Thinking control uses AI_LOCAL_FORCE_THINK=1 (legacy vars still supported)
EOF
}

COMMAND="${1:-}"
SUBCOMMAND="${2:-}"

case "$COMMAND" in
    goose)
        case "$SUBCOMMAND" in
            think) launch_goose_think ;;
            "") launch_goose ;;
            *) usage ;;
        esac
        ;;
    qwen)
        case "$SUBCOMMAND" in
            think) shift 2 || true; launch_qwen_think "$@" ;;
            "") shift 1 || true; launch_qwen "$@" ;;
            *) shift 1 || true; launch_qwen "$@" ;;
        esac
        ;;
    27b)
        start_27b_with_backend "$BACKEND_27B"
        ;;
    27b-mlx)
        start_27b_with_backend "mlx"
        ;;
    27b-llama)
        start_27b_with_backend "llama"
        ;;
    8b)
        start_8b_stack
        ;;
    35b)
        start_35b_stack
        ;;
    restart)
        restart_stack "$SUBCOMMAND"
        ;;
    status)
        show_status
        ;;
    stop)
        case "$SUBCOMMAND" in
            27b) stop_27b ;;
            8b) stop_35b ;;
            35b) stop_35b ;;
            ""|all) stop_all ;;
            *) log_error "Usage: ai-local stop [27b|8b|35b|all]" ;;
        esac
        ;;
    logs)
        [[ -n "$SUBCOMMAND" ]] || log_error "Usage: ai-local logs <service>"
        show_logs "$SUBCOMMAND"
        ;;
    download)
        [[ -n "$SUBCOMMAND" ]] || log_error "Usage: ai-local download <target>"
        download_model "$SUBCOMMAND"
        ;;
    doctor)
        doctor
        ;;
    config)
        show_config
        ;;
    proxy)
        case "$SUBCOMMAND" in
            start)
                if [[ "$BACKEND_27B" == "mlx" ]]; then
                    start_mlx_server
                else
                    start_llama_server
                fi
                start_ollama
                start_proxy_27b "$BACKEND_27B"
                start_proxy_35b
                ;;
            stop)
                stop_service "proxy-27b" "27B proxy" "nothink_proxy.py.*--port[ =]${LLAMA_PROXY_PORT}" 1
                stop_service "proxy-35b" "Ollama proxy (35B / optional 8B no-think)" "nothink_proxy.py.*--port[ =]${OLLAMA_PROXY_PORT}" 1
                ;;
            status)
                status_line "27B proxy" "$LLAMA_PROXY_PORT" "/health" "proxy-27b" "nothink_proxy.py.*--port[ =]${LLAMA_PROXY_PORT}"
                status_line "Ollama proxy (35B / optional 8B no-think)" "$OLLAMA_PROXY_PORT" "/health" "proxy-35b" "nothink_proxy.py.*--port[ =]${OLLAMA_PROXY_PORT}"
                ;;
            *)
                usage
                ;;
        esac
        ;;
    router)
        case "$SUBCOMMAND" in
            start) start_router ;;
            stop) stop_service "router" "model-router" "model_router.py.*--port[ =]${ROUTER_PORT}" 1 ;;
            status) status_line "model-router" "$ROUTER_PORT" "/health" "router" "model_router.py.*--port[ =]${ROUTER_PORT}" ;;
            *) usage ;;
        esac
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        log_error "Unknown command: $COMMAND"
        ;;
esac