#!/usr/bin/env zsh
# ============================================================================
# Qwen Model Switcher
# Switches qwen-code between Qwen3.6-27B (dense) and Qwen3.6-35B-A3B (MoE)
# Usage: qwen-switch [27b|35b|status|stop|show-config]
# ============================================================================

set -euo pipefail

SETTINGS="$HOME/.qwen/settings.json"

# ---- Source centralized config (with fallback defaults) ----
SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONF_FILE="${AI_LOCAL_DEV_CONF:-$PROJECT_ROOT/config/.qwen-local.conf}"

# Also check ~/.local/share/ai-local-dev/config/.qwen-local.conf if installed
if [[ ! -f "$CONF_FILE" ]] && [[ -f "$HOME/.local/share/ai-local-dev/config/.qwen-local.conf" ]]; then
    CONF_FILE="$HOME/.local/share/ai-local-dev/config/.qwen-local.conf"
fi

if [[ -f "$CONF_FILE" ]]; then
    source "$CONF_FILE"
fi

# Fallback defaults if not set by config file
LLAMA_PORT="${LLAMA_PORT:-8080}"
LLAMA_PROXY_PORT="${LLAMA_PROXY_PORT:-8081}"
OLLAMA_PORT="${OLLAMA_PORT:-11434}"
OLLAMA_PROXY_PORT="${OLLAMA_PROXY_PORT:-11435}"
QWEN_27B_MODEL="${QWEN_27B_MODEL:-$HOME/.local/share/llama-models/Qwen3.6-27B-UD-Q4_K_XL.gguf}"
LLAMA_CTX_SIZE="${LLAMA_CTX_SIZE:-131072}"
LLAMA_TEMP="${LLAMA_TEMP:-0.6}"
LLAMA_TOP_P="${LLAMA_TOP_P:-0.95}"
LLAMA_TOP_K="${LLAMA_TOP_K:-20}"
LLAMA_GPU_LAYERS="${LLAMA_GPU_LAYERS:-99}"
PROXY_TIMEOUT="${PROXY_TIMEOUT:-600}"
SERVICE_STARTUP_WAIT="${SERVICE_STARTUP_WAIT:-10}"

# ---- Model configs ----
MODEL_35B_ID="qwen3.6:35b-a3b"
MODEL_35B_NAME="Qwen3.6-35B-A3B (Ollama nothink proxy)"
MODEL_35B_URL="http://127.0.0.1:${OLLAMA_PROXY_PORT}/v1"

MODEL_27B_ID="Qwen3.6-27B-UD-Q4_K_XL.gguf"
MODEL_27B_NAME="Qwen3.6-27B (llama.cpp nothink proxy)"
MODEL_27B_URL="http://127.0.0.1:${LLAMA_PROXY_PORT}/v1"

# ---- Services management ----
start_services_27b() {
    echo "🚀 Starting services for Qwen3.6-27B..."

    # Start llama-server if not running
    if ! curl -s http://127.0.0.1:${LLAMA_PORT}/health > /dev/null 2>&1; then
        echo "   Starting llama-server on port ${LLAMA_PORT}..."
        nohup llama-server \
          --model "$QWEN_27B_MODEL" \
          --port "$LLAMA_PORT" \
          --ctx-size "$LLAMA_CTX_SIZE" \
          --temp "$LLAMA_TEMP" \
          --top-p "$LLAMA_TOP_P" \
          --top-k "$LLAMA_TOP_K" \
          --n-gpu-layers "$LLAMA_GPU_LAYERS" \
          > /tmp/llama-server.log 2>&1 &
        echo "   llama-server PID: $!"
        sleep 10
    else
        echo "   llama-server already running on port ${LLAMA_PORT}."
    fi

    # Start nothink proxy if not running
    if ! curl -s http://127.0.0.1:${LLAMA_PROXY_PORT}/health > /dev/null 2>&1; then
        echo "   Starting nothink proxy on port ${LLAMA_PROXY_PORT}..."
        # Try project venv first, then installed location
        if [[ -f "$PROJECT_ROOT/.venv/bin/python" ]]; then
            PYTHON="$PROJECT_ROOT/.venv/bin/python"
        elif [[ -f "$HOME/.local/share/ai-local-dev/.venv/bin/python" ]]; then
            PYTHON="$HOME/.local/share/ai-local-dev/.venv/bin/python"
        else
            PYTHON="python3"
        fi
        # Find proxy: installed location takes priority, then dev repo
        if [[ -f "$HOME/.local/share/ai-local-dev/bin/llama_nonthink_proxy.py" ]]; then
            PROXY_PATH="$HOME/.local/share/ai-local-dev/bin/llama_nonthink_proxy.py"
        else
            PROXY_PATH="$SCRIPT_DIR/llama_nonthink_proxy.py"
        fi
        nohup $PYTHON "$PROXY_PATH" --port "$LLAMA_PROXY_PORT" > /tmp/proxy-27b.log 2>&1 &
        echo "   Proxy PID: $!"
        sleep 3
    else
        echo "   nothink proxy already running on port ${LLAMA_PROXY_PORT}."
    fi
}

start_services_35b() {
    echo "🚀 Starting services for Qwen3.6-35B-A3B..."

    # Start Ollama if not running
    if ! curl -s http://127.0.0.1:${OLLAMA_PORT}/health > /dev/null 2>&1; then
        echo "   Starting Ollama..."
        nohup ollama serve > /tmp/ollama.log 2>&1 &
        sleep 3
    else
        echo "   Ollama already running on port ${OLLAMA_PORT}."
    fi

    # Start nothink proxy if not running
    if ! curl -s http://127.0.0.1:${OLLAMA_PROXY_PORT}/health > /dev/null 2>&1; then
        echo "   Starting Ollama nothink proxy on port ${OLLAMA_PROXY_PORT}..."
        # Try project venv first, then installed location
        if [[ -f "$PROJECT_ROOT/.venv/bin/python" ]]; then
            PYTHON="$PROJECT_ROOT/.venv/bin/python"
        elif [[ -f "$HOME/.local/share/ai-local-dev/.venv/bin/python" ]]; then
            PYTHON="$HOME/.local/share/ai-local-dev/.venv/bin/python"
        else
            PYTHON="python3"
        fi
        # Find proxy: installed location takes priority, then dev repo
        if [[ -f "$HOME/.local/share/ai-local-dev/bin/ollama_nothink_proxy.py" ]]; then
            PROXY_PATH="$HOME/.local/share/ai-local-dev/bin/ollama_nothink_proxy.py"
        else
            PROXY_PATH="$SCRIPT_DIR/ollama_nothink_proxy.py"
        fi
        nohup $PYTHON "$PROXY_PATH" --port "$OLLAMA_PROXY_PORT" > /tmp/proxy-35b.log 2>&1 &
        echo "   Proxy PID: $!"
        sleep 3
    else
        echo "   Ollama nothink proxy already running on port ${OLLAMA_PROXY_PORT}."
    fi
}

stop_all() {
    echo "🛑 Stopping all Qwen services..."
    pkill -f "llama-server.*${LLAMA_PORT}" 2>/dev/null || true
    pkill -f "llama_nonthink_proxy.py.*${LLAMA_PROXY_PORT}" 2>/dev/null || true
    pkill -f "ollama_nothink_proxy.py.*${OLLAMA_PROXY_PORT}" 2>/dev/null || true
    echo "   Done."
}

# ---- Settings update ----
update_settings() {
    local model_id="$1" model_name="$2" base_url="$3"

    cat > "$SETTINGS" << EOF
{
  "security": {
    "auth": {
      "selectedType": "openai",
      "apiKey": "sk-local-no-auth",
      "baseUrl": "${base_url}"
    }
  },
  "model": {
    "name": "${model_id}",
    "sessionTokenLimit": 32000,
    "generationConfig": {
      "timeout": 300000,
      "maxRetries": 1
    }
  },
  "\$version": 4
}
EOF
    echo "✅ settings.json updated → model: ${model_name}"
}

# ---- Status check ----
show_status() {
    echo "=== Qwen Setup Status ==="
    echo ""

    # Check llama-server (27B)
    if curl -sf http://127.0.0.1:${LLAMA_PORT}/health > /dev/null 2>&1; then
        echo "🟢 llama-server (Qwen3.6-27B)     → port ${LLAMA_PORT}"
    else
        echo "🔴 llama-server (Qwen3.6-27B)     → port ${LLAMA_PORT} (stopped)"
    fi

    # Check 27B nothink proxy
    if curl -sf http://127.0.0.1:${LLAMA_PROXY_PORT}/health > /dev/null 2>&1; then
        echo "🟢 nothink proxy (27B)             → port ${LLAMA_PROXY_PORT}"
    else
        echo "🔴 nothink proxy (27B)             → port ${LLAMA_PROXY_PORT} (stopped)"
    fi

    # Check Ollama (35B)
    if curl -sf http://127.0.0.1:${OLLAMA_PORT}/health > /dev/null 2>&1; then
        echo "🟢 Ollama (Qwen3.6-35B-A3B)       → port ${OLLAMA_PORT}"
    else
        echo "🔴 Ollama (Qwen3.6-35B-A3B)       → port ${OLLAMA_PORT} (stopped)"
    fi

    # Check Ollama nothink proxy
    if curl -sf http://127.0.0.1:${OLLAMA_PROXY_PORT}/health > /dev/null 2>&1; then
        echo "🟢 Ollama nothink proxy (35B)      → port ${OLLAMA_PROXY_PORT}"
    else
        echo "🔴 Ollama nothink proxy (35B)      → port ${OLLAMA_PROXY_PORT} (stopped)"
    fi

    # Check current qwen-code model
    echo ""
    if [ -f "$SETTINGS" ]; then
        current_url=$(python3 -c "import json; print(json.load(open('$SETTINGS'))['security']['auth']['baseUrl'])" 2>/dev/null || echo "unknown")
        current_model=$(python3 -c "import json; print(json.load(open('$SETTINGS'))['model']['name'])" 2>/dev/null || echo "unknown")
        echo "📋 Active qwen-code config:"
        echo "   Model:     ${current_model}"
        echo "   Base URL:  ${current_url}"
    else
        echo "⚠️  No settings.json found at ${SETTINGS}"
    fi

    echo ""
    echo "📌 Usage:"
    echo "   qwen-switch 27b               # Switch to Qwen3.6-27B (dense, best quality)"
    echo "   qwen-switch 35b               # Switch to Qwen3.6-35B-A3B (MoE, faster)"
    echo "   qwen-switch status             # Show current status"
    echo "   qwen-switch stop               # Stop all services"
    echo "   qwen-switch show-config        # Show current config values"
}

# ---- Show config ----
show_config() {
    echo "=== Current Qwen Configuration ==="
    echo ""
    echo "Config file: ${CONF_FILE}"
    if [[ -f "$CONF_FILE" ]]; then
        echo "   ✅ Loaded"
    else
        echo "   ⚠️  Not found — using defaults"
    fi
    echo ""
    echo "LLAMA_PORT=${LLAMA_PORT}"
    echo "LLAMA_PROXY_PORT=${LLAMA_PROXY_PORT}"
    echo "OLLAMA_PORT=${OLLAMA_PORT}"
    echo "OLLAMA_PROXY_PORT=${OLLAMA_PROXY_PORT}"
    echo "QWEN_27B_MODEL=${QWEN_27B_MODEL}"
    echo "LLAMA_CTX_SIZE=${LLAMA_CTX_SIZE}"
    echo "LLAMA_TEMP=${LLAMA_TEMP}"
    echo "LLAMA_TOP_P=${LLAMA_TOP_P}"
    echo "LLAMA_TOP_K=${LLAMA_TOP_K}"
    echo "LLAMA_GPU_LAYERS=${LLAMA_GPU_LAYERS}"
    echo "PROXY_TIMEOUT=${PROXY_TIMEOUT}"
    echo "SERVICE_STARTUP_WAIT=${SERVICE_STARTUP_WAIT}"
}

# ---- Main ----
case "${1:-status}" in
    27b)
        start_services_27b
        update_settings "$MODEL_27B_ID" "$MODEL_27B_NAME" "$MODEL_27B_URL"
        echo ""
        echo "🎯 Ready. Launch with: q22"
        ;;
    35b)
        start_services_35b
        update_settings "$MODEL_35B_ID" "$MODEL_35B_NAME" "$MODEL_35B_URL"
        echo ""
        echo "🎯 Ready. Launch with: q22"
        ;;
    stop)
        stop_all
        ;;
    show-config)
        show_config
        ;;
    status|*)
        show_status
        ;;
esac
